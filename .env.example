# The address Futurity reaches this plugin on. Must be public HTTPS before you
# register. A quick tunnel works while you develop:
#   cloudflared tunnel --url http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Odoo 19 instance root; JSON-2 paths are added by the client.
ODOO_URL=https://your-company.odoo.com
# Optional: needed when the hostname does not select one database.
ODOO_DATABASE=

# The Odoo API key is entered in Futurity, not in this file.
PORT=3000
